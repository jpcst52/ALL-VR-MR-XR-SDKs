{
  // Opens every WebXR (browser) project in the repository as its own folder in one VS Code window.
  // The Unity projects and native SDK samples are left out on purpose (they open in Unity / Android Studio / Xcode).
  // File > Open Workspace from File... > XR-Training.code-workspace
  "folders": [
    { "name": "Repository root (docs, scripts, tools, Pages workflow)", "path": "." },

    { "name": "WebXR: Practice Lab (17 scenarios)", "path": "training-simulations" },
    { "name": "WebXR: Multiplayer (relay, Circuit Lab VR, Site Safety AR, hydrostatic test)", "path": "multi-player" },
    { "name": "WebXR: A-Frame demo", "path": "a-frame" },
    { "name": "WebXR: Three.js demo", "path": "threejs" },
    { "name": "WebXR: Babylon.js demo", "path": "babylonjs" },
    { "name": "WebXR: raw WebXR Device API demo", "path": "webxr" },
    { "name": "WebXR: brand kit (shared)", "path": "brand-kit" },
    { "name": "WebXR: launcher (main menu)", "path": "launcher" }
  ],
  "settings": {
    "files.exclude": {
      "vive-steamvr": true,
      "unity-xri": true,
      "openxr": true,
      "steamvr": true,
      "meta-xr": true,
      "arcore-android": true,
      "apple-spatial": true,
      "**/Library": true,
      "**/Temp": true,
      "**/Logs": true,
      "**/obj": true,
      "**/UserSettings": true,
      "**/node_modules": true,
      "**/site": true,
      "**/builds": true
    },
    "search.exclude": {
      "**/Library": true,
      "**/Baked": true,
      "**/node_modules": true,
      "**/vendor": true,
      "**/site": true,
      "**/*.unity": true,
      "**/*.pptx": true
    },
    "files.watcherExclude": {
      "**/Library/**": true,
      "**/Temp/**": true,
      "**/node_modules/**": true,
      "**/Baked/**": true
    },
    "files.eol": "\n",
    "editor.formatOnSave": false
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "visualstudiotoolsforunity.vstuc",
      "dbaeumer.vscode-eslint",
      "bierner.markdown-preview-github-styles"
    ]
  }
}
