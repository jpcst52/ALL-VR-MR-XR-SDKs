  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2431918276966914829}
  m_Text: 'Supply:  5.0 V

    LED drop:  2.0 V

    LED current:  20 mA


    R
    = (Vs - Vf) / I

