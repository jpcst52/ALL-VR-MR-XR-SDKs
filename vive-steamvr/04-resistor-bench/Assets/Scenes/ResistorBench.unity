  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 679673126717731032}
  m_Text: 'Rated power is given at 70 C.

    Derates linearly to 0 W at 155 C.

    This
    board runs at 85 C:

    usable power = rated x 0.82.

    Pads fit parts up
    to 1/4 W.'
  m_OffsetZ: 0
  m_CharacterSize: 0.0016875
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 160
