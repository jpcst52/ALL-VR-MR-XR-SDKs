--- !u!102 &3399506025270406688
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6633482917093380499}
  m_Text: 'Station air:

    SULFUR-RICH

    (process gases nearby).


    Sulfur
    can attack the silver

    in standard terminations.

    Anti-sulfur types are
    built

    to resist it. Look for the

    green dot on the body.'
  m_OffsetZ: 0
  m_CharacterSize: 0.001875
  m_LineSpacing: 1
