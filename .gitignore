vive-steamvr/*/Assets/SteamVR_Input/
vive-steamvr/*/Assets/SteamVR_Input.meta
vive-steamvr/*/Assets/SteamVR_Resources/
vive-steamvr/*/Assets/SteamVR_Resources.meta
vive-steamvr/*/Assets/StreamingAssets/
vive-steamvr/*/Assets/StreamingAssets.meta
