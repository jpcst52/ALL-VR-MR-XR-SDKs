# University branding: the owner approved publishing the logo only (2026-11-02). The rest of branding/
# (brand guidelines PDF, EPS and other variants) stays out of the public repo.
branding/*
!branding/logo.png

# Third-party licensed assets (Unity Asset Store etc.) must never be committed
assets-private/

# Local status dashboard activity log
tools/status/activity-log.jsonl

# Self-signed demo certificates (private key)
multi-player/.certs/
tools/status/.dashboard-url
tools/status/.server.out

# Owner working notes (private)
CLAUDE.md

builds/
site/
builds.zip

vive-steamvr/steamvr-sample/
vive-steamvr/steamvr-sample-test/

# SteamVR plugin files are imported by scripts/setup-steamvr.ps1 (Valve distributes them; about 100 MB per project)
