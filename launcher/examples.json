{
  "meta": {
    "title": "XR Training Launcher",
    "subtitle": "Main menu for the Pitt-Bradford XR training examples: demos, Unity projects, native SDK samples, guides and decks.",
    "relayPort": 8443,
    "dashboardUrl": "tools/status/README.md"
  },
  "sections": [
    {
      "id": "browser",
      "title": "Browser demos",
      "intro": "Run in any WebGL browser on this PC. Each has a desktop fallback; the ENTER VR button appears only where the browser and headset support WebXR."
    },
    {
      "id": "multiplayer",
      "title": "Multiplayer (needs the relay)",
      "intro": "These pages talk to the WebSocket relay. Open this launcher from the relay (port 8443) so the links reach it."
    },
    {
      "id": "vive",
      "title": "Unity training projects (Vive / SteamVR)",
      "intro": "Unity 6 projects on the shared training kit. They run in the Unity editor on the Vive PC (desktop mode works without a headset), so these tiles open the project notes. Not tested on a headset yet."
    },
    {
      "id": "native",
      "title": "Native SDK examples (source)",
      "intro": "One small example per SDK. They need their own toolchain (Unity packages, Android Studio or Xcode) and are not served here, so each tile opens its notes with the setup steps."
    },
    {
      "id": "quest",
      "title": "Quest",
      "intro": "Opened from the Quest Browser, using the controller pointer. Nothing here has been tested on a physical Quest yet."
    }
  ],
  "demoPath": [
    {
      "step": 1,
      "minutes": 1,
      "title": "Frame the session",
      "who": "Presenter",
      "what": "Say these are learning prototypes, not certified training. Show this launcher and the badges that mark what is tested.",
      "ref": null
    },
    {
      "step": 2,
      "minutes": 4,
      "title": "Fieldwork Practice Lab on the desktop",
      "who": "Presenter",
      "what": "Open the lab, enter a name, and run one hands-on scenario such as Work at height. Point out the consequences and the critical safety misses.",
      "ref": "training-lab"
    },
    {
      "step": 3,
      "minutes": 3,
      "title": "Same lab in a headset",
      "who": "Volunteer in a headset; presenter on the desktop",
      "what": "Volunteer presses ENTER VR and selects hotspots with a controller. Hardware test is still pending, so keep the desktop view ready.",
      "ref": "training-lab-quest"
    },
    {
      "step": 4,
      "minutes": 3,
      "title": "Circuit Lab, shared bench",
      "who": "Presenter on desktop, volunteer joins the same room",
      "what": "Both join one room, load the demo circuit, close the switch, and watch the bulb light for everyone. Needs the relay.",
      "ref": "circuit-lab"
    },
    {
      "step": 5,
      "minutes": 2,
      "title": "Site Safety Layout",
      "who": "Presenter",
      "what": "Load the sample layout and let the checklist call out the missing exit or barrier. Desktop fallback; AR needs a phone or headset with WebXR.",
      "ref": "site-safety"
    },
    {
      "step": 6,
      "minutes": 2,
      "title": "Hydrostatic Test Bay in Unity",
      "who": "Presenter at the Vive PC",
      "what": "Show the Unity scene in desktop mode and explain where the Vive work is heading. Not yet tested in a headset.",
      "ref": "hydro-test-bay"
    }
  ],
